<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Salary_Range</fullName>
    <active>true</active>
    <errorConditionFormula>OR( Salary_Expectation__c  &lt;= 0.85 *  Position__r.Min_Salary__c ,  Salary_Expectation__c  &gt;= 1.15 *  Position__r.Max_Salary__c )</errorConditionFormula>
    <errorDisplayField>Salary_Expectation__c</errorDisplayField>
    <errorMessage>Salary Expectation Outside of Position&apos;s Accepted Range</errorMessage>
</ValidationRule>
